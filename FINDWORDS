  "Schlüssel", "Tasche", "Uhr", "Spiegel", "Bild", "Papier", "Stift", "Zimmer", "Küche", "Bett",
  "Schrank", "Lampe", "Teppich", "Brücke", "Straße", "Zug", "Flugzeug", "Fahrrad", "Schiff", "Insel",
  "König", "Königin", "Schloss", "Schwert", "Schild", "Gold", "Silber", "Stein", "Erde", "Feuerwerk",
